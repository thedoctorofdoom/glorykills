class GK_CrucibleController : CustomInventory
{
	const CRUCIBLE_LAYER = -70;

	bool busy;

	Default
	{
		+INVENTORY.UNDROPPABLE
		+INVENTORY.UNTOSSABLE
		+INVENTORY.PERSISTENTPOWER
		Inventory.MaxAmount 1;
	}

	bool RequestCrucible()
	{
		if (!GK_CombatUtil.CanActivate(owner, busy))
		{
			owner.A_StartSound("Equip_notready", CHAN_ITEM);
			return false;
		}
		if (owner.CountInv("CrucibleEnergy") < 1)
		{
			owner.A_Print("Not Enough Energy");
			owner.A_StartSound("Beep");
			return false;
		}
		if (owner.player.FindPSprite(CRUCIBLE_LAYER)) return false;

		GK_CombatUtil.ClearADS(owner);
		owner.A_StopSound(1);
		owner.A_StopSound(6);
		busy = true;
		return StartOverlay("Crucible");
	}

	bool StartOverlay(StateLabel stateLabel)
	{
		if (!owner || !owner.player) return false;
		let psp = owner.player.GetPSprite(CRUCIBLE_LAYER);
		psp.caller = self;
		psp.bAddBob = false;
		psp.bAddWeapon = false;
		psp.SetState(FindState(stateLabel));
		return true;
	}

	States
	{
	Use:
		TNT1 A 0;
		Fail;

	Crucible:
		TNT1 A 0 A_OverlayOffset(CRUCIBLE_LAYER, 0, WEAPONTOP);
		TNT1 A 0 A_GunFlash("Null");
		CRCB A 1 A_StartSound("Crucible_Select", CHAN_WEAPON, CHANF_OVERLAP);
		CRCB AABBCCJJ 2 bright A_OverlayOffset(CRUCIBLE_LAYER, -1, 2, WOF_ADD);
		CRCB D 1 bright
		{
			A_StartSound("Crucible_Deploy", CHAN_WEAPON, CHANF_OVERLAP);
			A_OverlayOffset(CRUCIBLE_LAYER, -2, 4, WOF_ADD);
			A_TakeInventory("CrucibleEnergy", 1);
		}
		CRCB D 3 bright A_OverlayOffset(CRUCIBLE_LAYER, -2, 4, WOF_ADD);
		CRCB DDD 1 bright A_OverlayOffset(CRUCIBLE_LAYER, 3, -6, WOF_ADD);
		CRCB D 1 bright A_OverlayOffset(CRUCIBLE_LAYER, 0.5, 4, WOF_ADD);
		Goto HoldCrucible;

	HoldCrucible:
		CRCB D 1 bright A_StartSound("Crucible_Idle", 10, CHANF_LOOP | CHANF_OVERLAP, 0.2);
		CRCB D 1 bright;
		TNT1 A 0 A_JumpIfInventory("DoGloryMelee", 1, "HoldCrucible+1");
		Goto DoCrucible;
		Loop;

	DoCrucible:
		CRCB D 1
		{
			A_StartSound("Crucible_Swing", CHAN_WEAPON, CHANF_OVERLAP);
			A_OverlayOffset(CRUCIBLE_LAYER, 10, 2, WOF_ADD);
		}
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, 20, 4, WOF_ADD);
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, 30, 6, WOF_ADD);
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, 40, 8, WOF_ADD);
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, 50, 10, WOF_ADD);
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, 60, 12, WOF_ADD);

		CRCB EEF 1
		{
			A_Saw("", "Crucible_Slice", 300, "CruciblePuff", SF_NOPULLIN | SF_NOTURN, 150, 32);
		}
		CRCB G 1
		{
			A_OverlayOffset(CRUCIBLE_LAYER, -40, 0, WOF_ADD);
			A_Saw("", "Crucible_Slice", 300, "CruciblePuff", SF_NOPULLIN | SF_NOTURN, 150, 32);
			A_SpawnItemEx("CrucibleBladeWave", 0, 0, invoker.owner.height / 2, 0, 0, 0, 0, SXF_CLIENTSIDE | SXF_TRANSFERPITCH);
		}
		CRCB HII 1
		{
			A_OverlayOffset(CRUCIBLE_LAYER, -40, 8, WOF_ADD);
			A_Saw("", "Crucible_Slice", 300, "CruciblePuff", SF_NOPULLIN | SF_NOTURN, 150, 32);
		}
		CRCB D 0 A_OverlayOffset(CRUCIBLE_LAYER, 325, 24, WOF_ADD);
		NULL A 10;
		TNT1 A 0 A_TakeInventory("DoGloryMelee", 1);
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, -60, -12, WOF_ADD);
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, -50, -10, WOF_ADD);
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, -40, -8, WOF_ADD);
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, -30, -6, WOF_ADD);
		CRCB D 1 A_OverlayOffset(CRUCIBLE_LAYER, -20, -4, WOF_ADD);
		CRCB D 1 bright A_OverlayOffset(CRUCIBLE_LAYER, -0.5, -4, WOF_ADD);
		CRCB DDD 1 bright A_OverlayOffset(CRUCIBLE_LAYER, -3, 6, WOF_ADD);
		CRCB D 3 bright A_OverlayOffset(CRUCIBLE_LAYER, 2, -4, WOF_ADD);
		CRCB D 1 bright A_OverlayOffset(CRUCIBLE_LAYER, 2, -4, WOF_ADD);
		CRCB JJCCBBAA 2 bright A_OverlayOffset(CRUCIBLE_LAYER, 1, -2, WOF_ADD);
		CRCB A 1 A_StopSound(10);
		CRCB A 1 A_StartSound("Crucible_Deselect", CHAN_WEAPON, CHANF_OVERLAP);
		CRCB A 5;
		TNT1 A 0
		{
			let ctrl = GK_CrucibleController(invoker);
			if (ctrl) ctrl.busy = false;
		}
		TNT1 A 1 A_Raise;
		Stop;
	}
}
