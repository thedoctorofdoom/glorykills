extend class PB_WeaponBase
{
	action void PB_ExecuteGK() {
		if(CountInv("GrabbedBarrel") >= 1 || CountInv("GrabbedFlameBarrel") >= 1 || CountInv("GrabbedIceBarrel") >= 1) { return; }

		if(GetPointer(AAPTR_PLAYER_GETTARGET) != NULL)
		{
			if(GetPointer(AAPTR_PLAYER_GETTARGET).bCountKill)
			{
				LookExParams look;
				look.FOV = 360;

				Actor monster = GetPointer(AAPTR_PLAYER_GETTARGET);

				if (monster.IsVisible(self, true, look) && Distance3D(monster) < 200 )
				{
					monster.A_Stop();
					double spd = 27.;
					vector3 delta = ( monster.pos.x - pos.x, monster.pos.y - pos.y, monster.pos.z - pos.z );
					double angleToMonster = AngleTo(monster);
					double pitchToMonster = VectorAngle( sqrt(delta.y * delta.y + delta.x * delta.x), delta.z );
					monster.A_SetPitch(pitchToMonster, SPF_INTERPOLATE);
					monster.A_SetAngle(angleToMonster+180,SPF_INTERPOLATE);

					vector3 neworigin = Vec3Offset(cos(angleToMonster) * spd,  sin(angleToMonster) * spd, sin(pitchToMonster) * spd);
					monster.SetOrigin(neworigin,true);

					int colorGreen = -16711936;
					int colorBlue = -16776961;
					if(monster.BloodColor == colorGreen)
					{
						PB_SetExecutionGreenBlood(true);
					}

					if(monster.BloodColor == colorBlue)
					{
						PB_SetExecutionBlueBlood(true);
					}

					A_SetAngle(AngleTo(monster));
					pitchToMonster = VectorAngle( sqrt(delta.y * delta.y + delta.x * delta.x), delta.z );
					A_SetPitch(-pitchToMonster);
					PB_SetPlayerExecutionProperties();

					StateLabel st = PB_ExecutionHandlerString(monster);
					monster.A_Die("Execution");
					A_Overlay(PSP_WEAPON,st);
					A_OverlayOffset(PSP_WEAPON,0,32);
					A_ClearOverlays(-998,-997);
				}
			}
		}
	}

	action void GK_ApplyBloodPunchSprite()
	{
		if (CountInv("PowerBloodOnVisor") >= 1) A_SetWeaponSprite("P2NK");
		else if (CountInv("PowerBlueBloodOnVisor") >= 1) A_SetWeaponSprite("P3NK");
		else if (CountInv("PowerGreenBloodOnVisor") >= 1) A_SetWeaponSprite("P4NK");
		else A_SetWeaponSprite("P1NK");
	}

	states
	{
	PerformExecution:
		TNT1 A 0
		{
			A_StartSound("GloryKill", CHAN_UI);
			if(GetCvar("be_Protection") == 1)
			{
				A_Giveinventory("Superarmor",1);
			}
			if(GetCvar("be_Fear") == 1)
			{
				A_Giveinventory("Fear",1);
			}
		}
		#### AAA 0 PB_ExecuteGK();
		TNT1 A 0;
		Goto GoingToReady;

	BloodPunch:
		TNT1 A 0 A_GunFlash("Null");
		TNT1 A 0 {
			A_TakeInventory("Zoomed", 1);
			A_ZoomFactor(1.0);
			A_TakeInventory("ADSmode", 1);
			A_ClearOverlays(-998, -997);
		}
		TNT1 A 0 A_StopSound(1);
		TNT1 A 0 A_StopSound(6);
		P1NK ABCD 1 {
			GK_ApplyBloodPunchSprite();
			A_SetRoll(roll + 2);
		}
		TNT1 A 1 A_SetRoll(roll + 2);
		TNT1 A 2;
		TNT1 A 0 A_StartSound("weapons/ultrwhoosh", 5);
		P1NK EF 1 {
			GK_ApplyBloodPunchSprite();
			A_SetRoll(roll - 2);
		}
		TNT1 A 0 {
			FLineTraceData trace;
			if (LineTrace(angle, 128, pitch, 0, player.mo.height * 0.5 - player.mo.floorclip + player.mo.AttackZOffset * player.crouchFactor, data: trace)
				&& trace.HitActor != null && trace.HitActor != player.mo && !trace.HitActor.player)
			{
				A_StartSound("BloodPunch", CHAN_AUTO);
				A_TakeInventory("BPtoken", 5);
				A_Explode(125, 200, 0, true, 200, 0, 0, "BPImpactPuff", "BloodPunch");
			}
		}
		P1NK G 1 GK_ApplyBloodPunchSprite();
		P1NK HIJKLMNO 1 {
			GK_ApplyBloodPunchSprite();
			A_SetRoll(roll - 1);
		}
		P1NK O 1 GK_ApplyBloodPunchSprite();
		P1NK PQ 1 {
			GK_ApplyBloodPunchSprite();
			A_SetRoll(roll + 2);
		}
		TNT1 A 0 A_SetRoll(0);
		TNT1 A 0 PB_SetUsingMelee(false);
		TNT1 A 0 A_TakeInventory("DoGloryMelee", 1);
		TNT1 A 0 A_TakeInventory("BloodPunchBusy", 1);
		TNT1 A 1 A_Raise;
		Goto GoingToReady;

	// PB Staging: delegate melee to GK routing. Downstream packs: A_JumpIf(isGKLoaded, "QuickMeleeGK").
	QuickMelee:
		TNT1 A 0 PB_SetReloading(false);
		TNT1 A 0 {
			A_ClearOverlays(-7,65);
			A_Gunflash("Null");
		}
		TNT1 A 0 A_Jump(256, "QuickMeleeGK");

	QuickMeleeGK:
		TNT1 A 0
		{
			if(countinv("FinisherToken",AAPTR_PLAYER_GETTARGET)>=1 && A_CheckLOF("Null",CLOFF_SETTARGET|CLOFF_NOAIM_VERT|CLOFF_IGNOREGHOST|CLOFF_MUSTBESOLID ,180))
			{
				A_TakeInventory("Zoomed",1);
				A_ZoomFactor(1.0);
				A_TakeInventory("ADSmode",1);
				return ResolveState("PerformExecution");
			}
			return ResolveState(null);
		}
		#### A 0 {
			A_StopSound(CHAN_WEAPON);
			A_StopSound(CHAN_VOICE);
			A_StopSound(CHAN_6);
			A_StopSound(CHAN_7);
		}
		TNT1 A 0 A_JumpIfInventory("CantDoAction",1,"FailOverlay");
		TNT1 A 0 A_JumpIfHealthLower(0, "FailOverlay");
		TNT1 A 0 {
			A_ClearOverlays(-10,65);
			A_Gunflash("Null");
		}
		#### AAA 0 {
			if(!be_ExecutionsON) {PB_Execute();}
			return resolveState(null);
		}
		TNT1 A 0 {
			if (CountInv("BPtoken") != 5) return ResolveState(null);
			if (CountInv("BloodPunchBusy")) return ResolveState(null);
			if (invoker.executingEnemy) return ResolveState(null);
			A_TakeInventory("Zoomed", 1);
			A_ZoomFactor(1.0);
			A_TakeInventory("ADSmode", 1);
			A_StopSound(1);
			A_StopSound(6);
			A_GiveInventory("BloodPunchBusy", 1);
			return ResolveState("BloodPunch");
		}
		goto GoMeleeInstead;
	}
}
